{
  "name": "MBP Catering - V3 quote receipt event-driven (proposal)",
  "active": false,
  "settings": { "executionOrder": "v1", "saveDataErrorExecution": "none", "saveDataSuccessExecution": "none", "saveManualExecutions": false, "saveExecutionProgress": false, "availableInMCP": false },
  "nodes": [
    { "id": "webhook", "name": "Receipt wake-up", "type": "n8n-nodes-base.webhook", "typeVersion": 2, "position": [-900, -80], "parameters": { "httpMethod": "POST", "path": "mbp-v3-quote-receipt-wake", "responseMode": "onReceived", "authentication": "headerAuth", "options": {} }, "retryOnFail": false },
    { "id": "schedule", "name": "Receipt recovery every 6 hours", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1.4, "position": [-900, 100], "parameters": { "rule": { "interval": [{ "field": "hours", "hoursInterval": 6 }] } }, "retryOnFail": false },
    { "id": "claim", "name": "Claim receipt", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.5, "position": [-620, 0], "parameters": { "method": "POST", "url": "https://mbp-catering.vercel.app/api/internal/automation/receipts/claim", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendBody": true, "specifyBody": "json", "jsonBody": "{\n  \"p_limit\": 1\n}", "options": { "timeout": 10000 } }, "retryOnFail": false, "onError": "stopWorkflow" },
    { "id": "exists", "name": "Receipt exists", "type": "n8n-nodes-base.if", "typeVersion": 2.4, "position": [-360, 0], "parameters": { "conditions": { "options": { "caseSensitive": true, "typeValidation": "strict", "version": 4 }, "conditions": [{ "leftValue": "={{ Array.isArray($json.events) && $json.events.length === 1 }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } }], "combinator": "and" } }, "retryOnFail": false },
    { "id": "started", "name": "Receipt delivery started", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.5, "position": [-100, -80], "parameters": { "method": "POST", "url": "https://mbp-catering.vercel.app/api/internal/automation/receipts/delivery-started", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ { event_id: $('Claim receipt').first().json.events[0].id, lock_token: $('Claim receipt').first().json.events[0].lockToken } }}", "options": { "timeout": 10000 } }, "retryOnFail": false, "onError": "stopWorkflow" },
    { "id": "confirmed", "name": "Receipt delivery started confirmed", "type": "n8n-nodes-base.if", "typeVersion": 2.4, "position": [160, -80], "parameters": { "conditions": { "options": { "caseSensitive": true, "typeValidation": "strict", "version": 4 }, "conditions": [{ "leftValue": "={{ $json.deliveryStarted === true }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } }], "combinator": "and" } }, "retryOnFail": false },
    { "id": "smtp", "name": "Send quote receipt", "type": "n8n-nodes-base.emailSend", "typeVersion": 2.1, "position": [420, -150], "parameters": { "fromEmail": "CONFIGURE_IN_N8N", "toEmail": "={{ $('Claim receipt').first().json.events[0].payload.recipientEmail }}", "subject": "={{ ({ fr: 'MBP Catering — confirmation de réception de votre demande', nl: 'MBP Catering — ontvangstbevestiging van uw aanvraag', en: 'MBP Catering — confirmation of receipt of your request' })[$('Claim receipt').first().json.events[0].payload.locale] || 'MBP Catering — confirmation de réception de votre demande' }}", "html": "={{ ({ fr: '<p>Bonjour,</p><p>Merci pour votre demande auprès de MBP Catering.</p><p>Nous confirmons sa bonne réception sous la référence <strong>' + $('Claim receipt').first().json.events[0].payload.reference + '</strong>.</p><p>Notre équipe examinera votre demande.</p><p>Bien cordialement,<br>MBP Catering</p>', nl: '<p>Hallo,</p><p>Bedankt voor uw aanvraag bij MBP Catering.</p><p>Wij bevestigen de ontvangst onder referentie <strong>' + $('Claim receipt').first().json.events[0].payload.reference + '</strong>.</p><p>Ons team bekijkt uw aanvraag.</p><p>Met vriendelijke groet,<br>MBP Catering</p>', en: '<p>Hello,</p><p>Thank you for your request to MBP Catering.</p><p>We confirm receipt under reference <strong>' + $('Claim receipt').first().json.events[0].payload.reference + '</strong>.</p><p>Our team will review your request.</p><p>Kind regards,<br>MBP Catering</p>' })[$('Claim receipt').first().json.events[0].payload.locale] || '' }}" }, "retryOnFail": false, "onError": "continueErrorOutput" },
    { "id": "succeeded", "name": "Mark receipt succeeded", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.5, "position": [700, -220], "parameters": { "method": "POST", "url": "https://mbp-catering.vercel.app/api/internal/automation/receipts/succeeded", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ { event_id: $('Claim receipt').first().json.events[0].id, lock_token: $('Claim receipt').first().json.events[0].lockToken } }}", "options": { "timeout": 10000 } }, "retryOnFail": false, "onError": "stopWorkflow" },
    { "id": "unknown", "name": "Mark receipt delivery unknown", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.5, "position": [700, -60], "parameters": { "method": "POST", "url": "https://mbp-catering.vercel.app/api/internal/automation/receipts/delivery-unknown", "authentication": "genericCredentialType", "genericAuthType": "httpHeaderAuth", "sendBody": true, "specifyBody": "json", "jsonBody": "={{ { event_id: $('Claim receipt').first().json.events[0].id, lock_token: $('Claim receipt').first().json.events[0].lockToken, error: String($json.error?.message || 'SMTP result uncertain after receipt delivery started').slice(0, 1000) } }}", "options": { "timeout": 10000 } }, "retryOnFail": false, "onError": "stopWorkflow" }
  ],
  "connections": {
    "Receipt wake-up": { "main": [[{ "node": "Claim receipt", "type": "main", "index": 0 }]] },
    "Receipt recovery every 6 hours": { "main": [[{ "node": "Claim receipt", "type": "main", "index": 0 }]] },
    "Claim receipt": { "main": [[{ "node": "Receipt exists", "type": "main", "index": 0 }]] },
    "Receipt exists": { "main": [[{ "node": "Receipt delivery started", "type": "main", "index": 0 }], []] },
    "Receipt delivery started": { "main": [[{ "node": "Receipt delivery started confirmed", "type": "main", "index": 0 }]] },
    "Receipt delivery started confirmed": { "main": [[{ "node": "Send quote receipt", "type": "main", "index": 0 }], []] },
    "Send quote receipt": { "main": [[{ "node": "Mark receipt succeeded", "type": "main", "index": 0 }], [{ "node": "Mark receipt delivery unknown", "type": "main", "index": 0 }]] }
  }
}
